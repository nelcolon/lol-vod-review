{
  "name": "@lvr/desktop",
  "version": "0.2.8",
  "private": true,
  "description": "Records your League of Legends games and finds the moments worth reviewing.",
  "main": "./out/main/index.js",
  "author": "divilight",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "smoke": "electron-vite build && set LVR_SMOKE=1&& electron ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@lvr/core": "*",
    "@lvr/schema": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  },
  "dependencies": {}
}
